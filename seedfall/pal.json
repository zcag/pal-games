  "leaderboards": [
    {
      "id": "core",
      "title": "Fastest to the Core",
      "order": "asc",
      "format": "time",
      "min": 60,
      "max": 360000
    }
  ],
  "store": {
    "tagline": "Dig down, haul ore up, wake the Seed at the core",
    "category": "fun",
    "play": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "actions": [
      {
        "title": "Drive and drill",
        "description": "Left and right drive, and drill sideways against rock; down drills, and on the pad drives into the mine. A and D, S too.",
        "keys": "left, right, down"
      },
      {
        "title": "Thrust",
        "description": "Up, W or Space.",
        "keys": "up"
      },
      {
        "title": "Use an item",
        "description": "Fuel cell, repair kit, dynamite, big charge, teleporter, coolant; 7 for Overcharge once it is fitted.",
        "keys": "1"
      },
      {
        "title": "Scanner pulse",
        "keys": "q"
      },
      {
        "title": "Dump the cheapest ore",
        "keys": "x"
      },
      {
        "title": "Enter a building",
        "description": "In town; in the core chamber, wake the Seed.",
        "keys": "e"
      },
      {
        "title": "Buy the suggested upgrade",
        "description": "In town.",
        "keys": "b"
      },
      {
        "title": "Workshop, cargo, map, collection log",
        "keys": "u, tab, m, l"
      },
      {
        "title": "Pause menu",
        "description": "The log, achievements and settings; Backspace closes a menu.",
        "keys": "p"
      },
      {
        "title": "Sound on or off",
        "keys": "shift+m"
      }
    ],
    "features": [
      "Fly a drilling pod down through seven biomes, from topsoil and the old mines through crystal caves, fungal hollows and magma to the ruins of the Sowers and the core",
      "Every dive is a fuel gamble: the HUD marks the fuel you need to get home, and a heavy cargo bay climbs slow and burns more",
      "Land on the depot pad and the haul sells, the tank fills and the hull is mended on their own; then buy the next upgrade with one key",
      "Rigs mine while you are away and fill the silo, the lab trickles research data, and research and modules change how you dig",
      "26 ores, jackpots and 31 relics to find, a collection log, achievements and orders from the market",
      "Wake the Seed at the core and launch it: shards buy permanent perks, and the next run is on another planet with its own rules",
      "Lit pixel art, music and sound, all made in code; the world is generated from a seed",
      "A leaderboard for the fastest run to the core; signed in, your achievements, log, perks and shards follow you to your other machines and play.cagdas.io"
    ],
    "screenshots": [
      {
        "file": "1-crystal.png",
        "caption": "Down in the crystal caves: the pod's lamp, the ore glinting in the rock, fuel, hull and cargo at a glance"
      },
      {
        "file": "2-town.png",
        "caption": "Gantry at sunset: land on the depot pad and the haul sells, the tank fills and the hull is mended"
      },
      {
        "file": "3-workshop.png",
        "caption": "The workshop: every part of the pod, what the next level does in plain numbers, and the one to buy next"
      },
      {
        "file": "4-magma.png",
        "caption": "The magma layer: lava lakes light the rock, and the heat climbs while you stay"
      },
      {
        "file": "5-chamber.png",
        "caption": "The Seed at the bottom of the world: wake it and launch it, and follow it to the next planet"
      },
      {
        "file": "6-log.png",
        "caption": "The collection log: every ore, jackpot and relic you have found, and where"
      }
    ]
  },
