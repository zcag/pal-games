          315,
          844,
          414
        ]
      },
      {
        "file": "3-garage.png",
        "caption": "The garage: your cars in their bays and the ones still under covers, each with what opens it"
      },
      {
        "file": "4-night.png",
        "caption": "Free Drive at night in the Saba: headlights on the road, tail lamps ahead, brake lights when a driver slows"
      },
      {
        "file": "5-results.png",
        "caption": "The end of a Free Drive run: the points and where they stand on the board"
      }
    ]
  },
